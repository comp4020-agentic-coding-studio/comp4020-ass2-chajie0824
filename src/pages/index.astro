---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Read algorithmic management closely enough to argue about it. Weeks 1–6
    take a delivery platform apart mechanism by mechanism — ETAs, ratings,
    incentive pay, worker classification — anchored in Uber, alongside a
    close second case, the Renwu magazine reporting on China's food-delivery
    riders that gave this course its title, and the workarounds riders
    actually use. Weeks 7–12 put those mechanisms in front of three
    regulators — China, Australia, the EU — and ask what each one decides an
    algorithm is allowed to do to a worker's day. You walk out having
    designed and defended one piece of a dispatch system yourself.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone willing to read a platform's own engineering writeup as closely
    as a regulatory determination, and treat neither as the last word. No
    law or computer-science background assumed — bring the willingness to
    check a claim against a second source rather than repeat it.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
