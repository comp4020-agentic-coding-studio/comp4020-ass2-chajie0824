---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Weeks 2–11 double as the graded weekly checkpoint: 2% each, checked live
    at the start of that week's session, 20% of the mark in total alongside
    the 80% carried by the three <a href={`${import.meta.env.BASE_URL}assessments/`}>assessments</a>.
    Week 1 is orientation and week 12 is capstone studio time — neither runs
    a graded checkpoint, but week 12 does carry one redeemable checkpoint;
    see <a href={`${import.meta.env.BASE_URL}policies/`}>policies</a> for how
    that works.
  </p>
  <SessionsGrid />
</ContentLayout>
